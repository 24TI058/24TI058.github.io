      },
      "source": [
        "確認のため，振幅比のヒストグラムを表示します．"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 179
        },
        "id": "5xf_Sq95nklD",
        "outputId": "2a4dc575-0b91-4e45-bf39-24009f75fbd2"
      },
      "source": [
        "fig3, ax3 = plt.subplots(1, 2, num=1, figsize=(12,3))\n",
        "_, _, _ = ax3[0].hist(R_a.flatten(), bins=200, alpha=0.5, histtype='stepfilled', range=(0,4), color='b')\n",
        "_, _, _ = ax3[1].hist(R_b.flatten(), bins=200, alpha=0.5, histtype='stepfilled', range=(0,4), color='r')\n",
        "for ax_ in ax3:\n",
        "  ax_.set_xlabel(\"振幅比\")\n",
