        "x_l = wav_data[:,0]\n",
        "x_r = wav_data[:,1]\n",
        "# - 音源Aのみ事前に収録した音声\n",
        "soundA_l = soundA[:,0]\n",
        "soundA_r = soundA[:,1]\n",
        "# - 音源Bのみ事前に収録した音声\n",
        "soundB_l = soundB[:,0]\n",
        "soundB_r = soundB[:,1]\n",
        "\n",
        "# 各サンプルの時刻(波形の図示で使う)\n",
        "t   = np.arange(len(x_l))/fs\n",
        "t1 = np.arange(len(originalA))/fs\n",
        "t2 = np.arange(len(originalB))/fs"
